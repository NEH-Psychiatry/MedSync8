# Root .env — read by the Express workbench (server.js) and the legacy
# Streamlit calculator. The FastAPI backend uses backend/.env.example and the
# RAG frontend uses frontend/.env.example.

# --- Psychiatry AI Workbench (root src/ + server.js) ---
# Anthropic API key (required; the server exits at startup without it)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Express proxy port (optional, defaults to 3001)
PORT=3001

# CORS origin for the workbench (optional, defaults to http://localhost:5173)
ALLOWED_ORIGIN=http://localhost:5173

# --- Legacy Streamlit medication sync calculator ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
STRIPE_PAYMENT_LINK=https://buy.stripe.com/your-link
