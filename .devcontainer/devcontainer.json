{
  "name": "MedSync8 (Python 3.11 + Node 20)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "vitest.explorer"
      ]
    }
  },
  "updateContentCommand": "python3 -m venv backend/.venv && backend/.venv/bin/pip install --upgrade pip && backend/.venv/bin/pip install -r backend/requirements.txt -r backend/requirements-test.txt -r requirements.txt && cd frontend && npm ci",
  "portsAttributes": {
    "8000": { "label": "Backend (FastAPI)" },
    "5173": { "label": "Frontend (Vite)" },
    "8501": { "label": "Legacy Streamlit calculator" }
  },
  "forwardPorts": [8000, 5173, 8501]
}
